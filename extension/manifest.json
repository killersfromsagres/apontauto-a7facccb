{
  "manifest_version": 3,
  "name": "Apont Auto — Automação Prisma4",
  "version": "1.0.0",
  "description": "Executa apontamentos de OS no Prisma4 direto pelo navegador, integrado ao painel Apont Auto.",
  "permissions": ["storage", "tabs", "scripting", "notifications", "alarms"],
  "host_permissions": [
    "https://cimogps.com.br/*",
    "https://*.cimogps.com.br/*",
    "https://apontauto.lovable.app/*",
    "https://*.lovable.app/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "Apont Auto — Automação Prisma4",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://cimogps.com.br/*", "https://*.cimogps.com.br/*"],
      "js": ["automation.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://apontauto.lovable.app/*",
        "https://*.lovable.app/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": ["bridge.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
