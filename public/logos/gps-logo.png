      <svg width="28" height="28" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M21 12c0 4.418-4.03 8-9 8-1.001 0-1.957-.143-2.844-.405-.304-.09-.616-.135-.93-.135-.569 0-1.124.169-1.596.482l-2.17 1.434c-.37.244-.832-.106-.728-.532l.668-2.726c.108-.44.046-.905-.17-1.299C2.535 15.804 2 13.973 2 12 2 7.582 6.03 4 11 4s10 3.582 10 8Z" fill="currentColor"/></svg>
