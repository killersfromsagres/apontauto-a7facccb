        <input class="gp-chat__input" id="gpChatInput" type="text" name="message" placeholder="Digite sua mensagem…" required enterkeyhint="send" />
        <button type="button" class="gp-chat__send" aria-label="Enviar mensagem" style="margin-bottom:19px">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="m3.4 20.4 17.6-8.8L3.4 2.8l-.8 6.4 10 2.4-10 2.4.8 6.4Z" fill="#fff" />
          </svg>
        </button>
      </form>
      <div class="gp-chat__disclaimer">Agente atende exclusivamente solicitações de contato comercial/proposta comercial</div>
    </section>
